# Add at least one API key. Keep this file private; never commit .env.
# Free account/key pages:
# Groq: https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/settings/keys

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default models. OpenRouter's free router selects an available free model.
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free

# Optional: change the local embedding/reranking models if needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
